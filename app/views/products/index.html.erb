
<h1>Products</h1>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Category</th>
      <th>Price</th>
      <th>Stock quantity</th>
      <th>Details</th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= product.title %></td>
        <td><%= product.category&.name || "Uncategorized" %></td>
        <td><%= number_to_currency(product.price) %></td>
        <td><%= product.stock_quantity %></td>
        <td><%= link_to "Show", product_path(product) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
